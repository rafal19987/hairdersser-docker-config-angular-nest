# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hairdresser
MYSQL_USERNAME=hairdresser_user
MYSQL_PASSWORD=hairdresser_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_SYNCHRONIZE=false

# Backend
NODE_ENV=production
JWT_ACCESS_TOKEN_SECRET_KEY=twoj-secret-access
JWT_REFRESH_TOKEN_SECRET_KEY=twoj-secret-refresh
JWT_ACCESS_TOKEN_EXPIRES_IN=10h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
MAILTRAP_API_KEY=
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=
MAIL_FROM=noreply@hairdresser.pl
APP_URL=http://localhost

# Frontend
API_URL=http://localhost:3000
FRONTEND_PORT=80

# Seed
SEED_ADMIN_EMAIL=admin@hairdresser.pl
SEED_ADMIN_PASSWORD=Admin1234!