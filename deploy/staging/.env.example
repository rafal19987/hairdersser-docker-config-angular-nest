# Copied to /opt/hairdresser/.env by setup-server.sh, which fills in the domain and random secrets

# Website at DOMAIN, admin panel at admin.DOMAIN, API at api.DOMAIN,
# e.g. 203-0-113-10.sslip.io until the server has its own domain
DOMAIN=

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

JWT_ACCESS_TOKEN_SECRET_KEY=
JWT_REFRESH_TOKEN_SECRET_KEY=
JWT_CLIENT_ACCESS_TOKEN_SECRET_KEY=

SEED_ADMIN_EMAIL=admin@staging.local
SEED_ADMIN_PASSWORD=

# Demo employees and clients log in with the passwords published in the repository, so anyone could use them
SEED_DEMO_DATA=false
