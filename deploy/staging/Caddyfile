# Caddy gets and renews the HTTPS certificates for these addresses on its own

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy landing:3001
}

admin.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:80
}

api.{$DOMAIN} {
	encode zstd gzip

	# Swagger UI and its JSON/YAML; the API itself stays open for the website and the admin panel
	@docs path /api/docs*
	basic_auth @docs {
		{$DOCS_USER} {$DOCS_PASSWORD_HASH}
	}

	reverse_proxy backend:3000
}
